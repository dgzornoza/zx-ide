{
    "folders": [
        {
            "name": ".github",
            "path": ".github"
        },	
        {
            "name": "doc",
            "path": "doc"
        },	
        {
            "name": "shared",
            "path": "projects/shared"
        },			
        {
            "name": "vscode-extension",
            "path": "projects/vscode-extension"
        },		
        {
            "name": "cli",
            "path": "projects/cli"
        },
        {
            "name": "web-client",
            "path": "projects/web-client"
        },		

    ],
    "extensions": {
        "recommendations": [
            "dbaeumer.vscode-eslint",
            "esbenp.prettier-vscode",
            "editorconfig.editorconfig",
            "christian-kohler.path-intellisense"
        ]
    },
    "settings": {
        "eslint.workingDirectories": [
            {
                "directory": "shared"
            },		
            {
                "directory": "vscode-extension"
            },		
            {
                "directory": "cli"
            },
            {
                "directory": "web-client"
            }			
        ],
        "files.exclude": {
			".devcontainer": true,
		    "**/.git": true,        			
			"**/.github": true,  
			"**/.agents": true,
            "**/dist/**": true,
            "**/out/**": true,
            "**/node_modules/**": true
        },
        "files.watcherExclude": {
            "**/dist/**": true,
            "**/out/**": true,
            "**/node_modules/**": true
        },
        "search.exclude": {
			".devcontainer": true,
		    "**/.git": true,        				
            "**/dist/**": true,
            "**/out/**": true,
            "**/node_modules/**": true,
			"./projects/vscode-extension/media/*": true,
        },
        "typescript.tsdk": "${workspaceFolder:vscode-extension}/node_modules/typescript/lib"
    }
}