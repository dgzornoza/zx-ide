{
  "name": "zxide",
  "displayName": "zxide",
  "description": "Extension for development on retro computers with vscode.",
  "version": "1.4.6",
  "publisher": "dgzornoza",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgzornoza/zx-ide.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "workspaceContains:.zxide.json"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "zx-ide.open-help",
        "title": "%extension.cmd-title.open-help%"
      },
      {
        "command": "zx-ide.create-project",
        "title": "%extension.cmd-title.create-project%"
      },
      {
        "command": "zx-ide.extract-tiles",
        "title": "%extension.cmd-title.extract-tiles%"
      },
      {
        "command": "zx-ide.extract-sprites",
        "title": "%extension.cmd-title.extract-sprites%"
      },
      {
        "command": "zx-ide.extract-map-tileset",
        "title": "%extension.cmd-title.extract-map-tileset%"
      },
      {
        "command": "zx-ide.create-sprites",
        "title": "%extension.cmd-title.create-sprites%"
      }
    ],
    "configuration": {
      "title": "Z88DK",
      "properties": {
        "zxide.z88dk.useAsmDebug": {
          "type": "boolean",
          "default": false,
          "description": "%extension.configuration.z88dk.useAsmDebug%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "build-cli": "pnpm --filter zx-ide-cli run build",
    "build-webview": "pnpm --filter zx-ide-web-client run build",
    "watch": "pnpm run build-webview && pnpm run build-cli && webpack --watch",
    "package": "pnpm run build-webview && pnpm run build-cli && webpack --mode production --devtool hidden-source-map",
    "compile": "webpack",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "inversify": "^6.0.3",
    "jsonc-parser": "^3.3.1",
    "loglevel": "^1.9.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "18.x",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vscode/test-electron": "^2.4.1",
    "autoprefixer": "^10.4.20",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "glob": "^8.1.0",
    "globals": "^17.13.0",
    "mocha": "^10.2.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.10",
    "vscode-nls-dev": "^4.0.4",
    "vue": "^3.5.12",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
