{
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "node",
    "module": "ES2022",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "reflect-metadata"
    ],
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@commands/*": [
        "src/commands/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@z88dk/*": [
        "src/z88dk/*"
      ],
      "@sjasmplus/*": [
        "src/sjasmplus/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "webview",
    "media",
    "dist",
    "out",
    "node_modules"
  ]
}