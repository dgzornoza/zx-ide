{
  "name": "zx-ide-cli",
  "version": "1.4.0",
  "description": "cli for zx spectrum development with zxide vscode extension",
  "keywords": [
    "zx spectrum",
    "cli",
    "zxide"
  ],
  "author": "David González Zornoza <dgzornoza@dgzornoza.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgzornoza/zx-ide.git"
  },
  "bugs": {
    "url": "https://github.com/dgzornoza/zx-ide/issues"
  },
  "main": "./dist/zx-ide-cli.js",
  "scripts": {
    "prepublish": "pnpm run build",
    "start": "webpack --mode development --config webpack.config.js && node --inspect=9229 dist/zx-ide-cli.js",
    "build": "webpack --mode production --config webpack.prod.js",
    "watch": "webpack --mode development --config webpack.config.js --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.1",
    "commander": "^10.0.1",
    "figlet": "^1.6.0",
    "node-stream-zip": "^1.15.0",
    "os-locale": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/figlet": "^1.5.6",
    "@types/inquirer": "^9.0.3",
    "@types/node": "18.x",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  }
}
