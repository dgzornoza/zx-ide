{
    "compilerOptions": {
        "baseUrl": "./",
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "strict": true,
        "jsx": "preserve",
        "types": [
            "vite/client"
        ],
        "allowJs": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "index.html",
        "extract-graphics.html"
    ]
}