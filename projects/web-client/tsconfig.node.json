{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022"
        ],
        "allowJs": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "vite.config.ts",
        "postcss.config.cjs",
        "tailwind.config.cjs"
    ]
}